// 关闭自动几何合并（全局生效）
Geometry.AutoCoherence = 0;

a = 1.0;
b = 2.0;
n = 32;
m = 32;

// 1. 下底边：点1→点2
Point(1) = {0, 0, 0};     // 定义第一个点：下区左下角
Point(2) = {a, 0, 0};     // 定义第二个点：下区右下角
Line(1) = {1, 2};         // 下区底边（Γ¹）

// 2. 下右边：点2→点6
Point(6) = {a, b/2, 0};   // 定义第六个点：下区右上角（中间界面右端点）
Line(2) = {2, 6};         // 下区右边（Γ²下部分）

// 3. 下顶边：点5→点6
Point(5) = {0, b/2, 0};   // 定义第五个点：下区左上角（中间界面左端点）
Line(3) = {5, 6};         // 下区顶边（Γ³⁻，独立线）

// 4. 下左边：点5→点1
Line(4) = {5, 1};         // 下区左边（Γ⁴下部分）

// 5. 上底边：点5→点6（与Line3几何重合，但不合并）
Line(5) = {5, 6};         // 上区底边（Γ³⁺，独立线）

// 6. 上右边：点6→点3
Point(3) = {a, b, 0};     // 定义第三个点：上区右上角
Line(6) = {6, 3};         // 上区右边（Γ²上部分）

// 7. 上顶边：点3→点4
Point(4) = {0, b, 0};     // 定义第四个点：上区左上角
Line(7) = {3, 4};         // 上区顶边（Γ⁵）

// 8. 上左边：点4→点5
Line(8) = {4, 5};         // 上区左边（Γ⁴上部分）


Curve Loop(1) = {1, 2, -3, 4};  // 下区曲线环（-3表示Line3反向）
Curve Loop(2) = {5, 6, 7, 8};   // 上区曲线环

Plane Surface(1) = {1};  // 下方计算域Ω₁
Plane Surface(2) = {2};  // 上方计算域Ω₂

// ==============================================
// 结构化网格划分
// ==============================================
Transfinite Curve{1, 3, 5, 7} = n;  // 水平方向线的单元数
Transfinite Curve{2, 4, 6, 8} = m;  // 竖直方向线的单元数

// 下半部分设为Right：生成从左下到右上的对角线网格（即 / 形状）
Transfinite Surface{1} = {1, 2, 6, 5} Right;

// 上半部分设为Left：生成从左上到右下的对角线网格（即 \ 形状）
Transfinite Surface{2} = {5, 6, 3, 4} Left;

// ==============================================
// 物理组定义（完全保留界面独立性）
// ==============================================
Physical Curve("Γ¹") = {1};       // 底边
Physical Curve("Γ²") = {2, 6};    // 右边（上下两部分合并）
Physical Curve("Γ³⁻") = {3};      // 中间界面下侧（Ω₁的顶边）
Physical Curve("Γ³⁺") = {5};      // 中间界面上侧（Ω₂的底边）
Physical Curve("Γ⁴") = {4, 8};    // 左边（上下两部分合并）
Physical Curve("Γ⁵") = {7};       // 顶边

Physical Surface("Ω") = {1, 2};   // 合并为单一计算域Ω

Mesh 2;

// 保存网格
 Save "DG_impact_32.msh";